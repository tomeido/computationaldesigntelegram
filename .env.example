# 비밀 키는 이 파일을 .env로 복사한 뒤 입력하세요.
TELEGRAM_BOT_TOKEN=
# 공개 채널: @your_channel / 비공개 채널: -100으로 시작하는 숫자 ID
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
# 공개 채널 링크 또는 비공개 방 초대 링크
TELEGRAM_INVITE_URL=
# local: 봇 토큰만 사용, setup-translator로 모델을 먼저 설치합니다.
# gemini: 아래 Google AI Studio 키로 번역하며 모델 다운로드가 필요하지 않습니다.
TRANSLATION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOCAL_MODEL_PATH=data/models/m2m100
CHANNEL_NAME="컴퓨트 디자인 브리핑 | Web3 · AI"
TIMEZONE=Asia/Seoul
POST_TIMES=09:00,18:00
MAX_POSTS=5
MAX_AGE_DAYS=7
MAX_CANDIDATES=15
SOURCES_FILE=config/sources.json
# 비워 두면 GitHub 릴리스 수집과 /tools 추천 목록을 끕니다. 별도 GitHub API 키는 필요 없습니다.
REPOSITORIES_FILE=config/repositories.json
DATABASE_PATH=data/bot.sqlite3

# true이면 채널 발행 후 같은 글을 구독자마다 개별 발송합니다.
MAILING_ENABLED=false
# 선택: 시작 시 XLSX 가져오기. Docker에서는 /app/data/ 아래로 복사하세요.
MAILING_XLSX_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# 표시 이름 없이 발신 이메일 주소만 입력
SMTP_FROM=
