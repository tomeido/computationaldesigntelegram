# 비밀 키는 이 파일을 .env로 복사한 뒤 입력하세요.
TELEGRAM_BOT_TOKEN=
# 공개 채널: @your_channel / 비공개 채널: -100으로 시작하는 숫자 ID
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
# 공개 채널 링크 또는 비공개 방 초대 링크
TELEGRAM_INVITE_URL=
# local: 봇 토큰만 사용, setup-translator로 모델을 먼저 설치합니다.
# gemini: 아래 Google AI Studio 키로 번역하며 모델 다운로드가 필요하지 않습니다.
TRANSLATION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOCAL_MODEL_PATH=data/models/m2m100
CHANNEL_NAME="컴퓨트 디자인 브리핑 | Web3 · AI"
TIMEZONE=Asia/Seoul
POST_TIMES=09:00,18:00
MAX_POSTS=5
MAX_AGE_DAYS=7
MAX_CANDIDATES=15
SOURCES_FILE=config/sources.json
# 비워 두면 GitHub 릴리스 수집과 /tools 추천 목록을 끕니다. 별도 GitHub API 키는 필요 없습니다.
REPOSITORIES_FILE=config/repositories.json
DATABASE_PATH=data/bot.sqlite3

# true이면 채널 발행 후 여러 소식을 수신자별 묶음 메일로 발송합니다.
MAILING_ENABLED=false
# 실제 메일 통수 기준; 초과한 수신자는 대기열에 남습니다.
MAILING_BATCH_LIMIT=200
MAILING_DAILY_LIMIT=400
# Gmail 계정: 발송 전에 반송 확인. SMTP 계정으로 IMAP에 로그인하며 메일은 읽음/삭제 처리하지 않습니다.
MAILING_BOUNCE_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# 선택: 시작 시 XLSX 가져오기. Docker에서는 /app/data/ 아래로 복사하세요.
MAILING_XLSX_PATH=
# 수신 거부 주소의 JSON 배열. 개인정보 파일은 data/에 두고 Git에 올리지 마세요.
MAILING_EXCLUSIONS_PATH=data/mailing/exclusions.json
# 설정하면 메일 하단에 원클릭 수신 해지 버튼을 넣고 HTTP 처리기를 함께 실행합니다.
# 기존 HTTPS 프록시에서 이 주소의 /unsubscribe/ 경로를 아래 포트로 연결하세요.
MAILING_UNSUBSCRIBE_BASE_URL=
MAILING_UNSUBSCRIBE_HOST=127.0.0.1
MAILING_UNSUBSCRIBE_PORT=8085
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# 표시 이름 없이 발신 이메일 주소만 입력
SMTP_FROM=
